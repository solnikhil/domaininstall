{
  "name": "domaininstall-demo",
  "version": "1.0.0",
  "description": "Remotion short for domaininstall: a 25s white-paper film cut for social",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "audio": "node scripts/generate-audio.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "render": "remotion render DomainInstall out/domaininstall.mp4 --crf=16",
    "render:demo": "remotion render DomainInstall domaininstall-demo.mp4 --crf=16",
    "still": "remotion still DomainInstall out/frame.png"
  },
  "dependencies": {
    "@remotion/google-fonts": "4.0.500",
    "@remotion/media": "4.0.500",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.500"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.500",
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
